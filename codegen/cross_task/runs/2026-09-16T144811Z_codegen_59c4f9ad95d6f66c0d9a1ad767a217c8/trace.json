  "final_source": "def solve(strings):\n    def is_balanced(s):\n        stack = []\n        bracket_map = {\n            ')': '(',\n            ']': '[',\n            '}': '{'\n        }\n        for char in s:\n            if char in bracket_map.values():\n                stack.append(char)\n            elif char in bracket_map:\n                if not stack or stack.pop() != bracket_map[char]:\n                    return False\n        return not stack\n\n    return [is_balanced(string) for string in strings]",
