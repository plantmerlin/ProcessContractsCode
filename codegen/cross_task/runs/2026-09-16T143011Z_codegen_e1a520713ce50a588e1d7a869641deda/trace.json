  "final_source": "def binary_search(arr, val, start, end):\n    while start < end:\n        mid = (start + end) // 2\n        if arr[mid] < val:\n            start = mid + 1\n        else:\n            end = mid\n    return start\n\n\ndef solve(xs):\n    for i in range(1, len(xs)):\n        val = xs[i]\n        j = binary_search(xs, val, 0, i)\n        xs = xs[:j] + [val] + xs[j:i] + xs[i+1:]\n    return xs\n",
  "final_stdout": "[1, 2, 3, 4, 5, 6, 7, 8, 9]\n",
