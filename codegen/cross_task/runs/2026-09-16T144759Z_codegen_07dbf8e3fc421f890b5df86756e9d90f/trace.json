  "final_source": "def solve(strings):\n    def is_balanced(s):\n        stack = []\n        mapping = {')': '(', ']': '[', '}': '{'}\n        for char in s:\n            if char in mapping.values():\n                stack.append(char)\n            elif char in mapping:\n                if stack and stack[-1] == mapping[char]:\n                    stack.pop()\n                else:\n                    return False\n        return not stack\n    \n    return [is_balanced(s) for s in strings]",
