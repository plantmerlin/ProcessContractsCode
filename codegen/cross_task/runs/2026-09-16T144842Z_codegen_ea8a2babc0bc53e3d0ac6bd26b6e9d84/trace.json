  "final_source": "def solve(grid):\n    if not grid:\n        return 0\n\n    def dfs(x, y):\n        # If out of bounds or at a water cell, return\n        if x < 0 or x >= len(grid) or y < 0 or y >= len(grid[0]) or grid[x][y] == 0:\n            return\n        # Mark the cell as visited\n        grid[x][y] = 0\n        # Check all four directions\n        dfs(x + 1, y)\n        dfs(x - 1, y)\n        dfs(x, y + 1)\n        dfs(x, y - 1)\n\n    island_count = 0\n\n    for i in range(len(grid)):\n        for j in range(len(grid[0])):\n            if grid[i][j] == 1:\n                # Start a DFS for each unvisited piece of land\n                dfs(i, j)\n                island_count += 1\n\n    return island_count",
