  "final_source": "def solve(grid):\n    if not grid:\n        return 0\n    \n    def dfs(x, y):\n        if x < 0 or x >= len(grid) or y < 0 or y >= len(grid[0]) or grid[x][y] == 0:\n            return\n        grid[x][y] = 0  # Mark the visited cell\n        # Explore neighbors\n        dfs(x - 1, y)\n        dfs(x + 1, y)\n        dfs(x, y - 1)\n        dfs(x, y + 1)\n\n    islands = 0\n    for i in range(len(grid)):\n        for j in range(len(grid[0])):\n            if grid[i][j] == 1:  # Found an island\n                dfs(i, j)\n                islands += 1\n    return islands",
  "final_stdout": "6\n",
