  "final_source": "def solve(orders):\n    customer_totals = {}\n    \n    for order in orders:\n        if order['status'] != 'cancelled':\n            customer = order['customer']\n            total = order['qty'] * order['unit_cents']\n            if customer in customer_totals:\n                customer_totals[customer] += total\n            else:\n                customer_totals[customer] = total\n    \n    return customer_totals",
