  "final_source": "def solve(xs):\n    def binary_search(sub, val):\n        low, high = 0, len(sub) - 1\n        while low <= high:\n            mid = (low + high) // 2\n            if sub[mid] < val:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return low\n\n    for i in range(1, len(xs)):\n        key = xs[i]\n        # Find location where key should be inserted\n        j = binary_search(xs[:i], key)\n        # Move all elements after location to one position ahead\n        xs = xs[:j] + [key] + xs[j:i] + xs[i+1:]\n    return xs",
