  "final_source": "def solve(xs):\n    n = len(xs)\n    sorted_list = xs[:]\n    for i in range(n):\n        for j in range(0, n-i-1):\n            if sorted_list[j] > sorted_list[j+1]:\n                sorted_list[j], sorted_list[j+1] = sorted_list[j+1], sorted_list[j]\n    return sorted_list",
