  "final_source": "def solve(s):\n    if not s:\n        return \"\"\n    encoded = []\n    current_char = s[0]\n    count = 1\n    for char in s[1:]:\n        if char == current_char:\n            count += 1\n        else:\n            encoded.append(f\"{current_char}{count}\")\n            current_char = char\n            count = 1\n    encoded.append(f\"{current_char}{count}\")\n    return ''.join(encoded)",
