  "final_source": "def solve(xs):\n    n = len(xs)\n    for i in range(n):\n        swapped = False\n        for j in range(0, n-i-1):\n            if xs[j] > xs[j+1]:\n                xs[j], xs[j+1] = xs[j+1], xs[j]\n                swapped = True\n        if not swapped:\n            break\n    return xs",
