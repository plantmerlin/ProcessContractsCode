  "final_source": "def solve(xs):\n    def binary_search(arr, val, start, end):\n        # Binary search to find the index where val should be inserted\n        while start < end:\n            mid = (start + end) // 2\n            if arr[mid] < val:\n                start = mid + 1\n            else:\n                end = mid\n        return start\n    \n    for i in range(1, len(xs)):\n        val = xs[i]\n        # Find the position where val should be inserted\n        j = binary_search(xs, val, 0, i)\n        # Insert val at the right position\n        xs = xs[:j] + [val] + xs[j:i] + xs[i+1:]\n    return xs\n",
