  "final_source": "def solve(grid):\n    def dfs(x, y):\n        if x < 0 or x >= len(grid) or y < 0 or y >= len(grid[0]) or grid[x][y] == 0:\n            return\n        grid[x][y] = 0  # Mark the cell as visited\n        # Visit all four adjacent cells\n        dfs(x + 1, y)\n        dfs(x - 1, y)\n        dfs(x, y + 1)\n        dfs(x, y - 1)\n\n    if not grid or not grid[0]:\n        return 0\n\n    num_islands = 0\n\n    for i in range(len(grid)):\n        for j in range(len(grid[0])):\n            if grid[i][j] == 1:\n                dfs(i, j)\n                num_islands += 1\n\n    return num_islands\n",
