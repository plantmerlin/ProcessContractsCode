  "final_source": "def solve(strings):\n    def is_balanced(s):\n        stack = []\n        bracket_map = {')': '(', '}': '{', ']': '['}\n        for char in s:\n            if char in bracket_map.values():\n                stack.append(char)\n            elif char in bracket_map.keys():\n                if stack == [] or bracket_map[char] != stack.pop():\n                    return False\n        return stack == []\n        \n    return [is_balanced(s) for s in strings]",
