{"kind": "span_end", "trace_id": "trace_205b0566cf5a4d0e9b2902490436c2e9", "span_id": "span_18eae0b08e2a4996b7355fa0", "parent_id": "span_c26779060d904439bf1872ec", "payload": {"type": "function", "name": "write_source", "input": "{\"source\":\"def solve(grid):\\n    if not grid:\\n        return 0\\n    \\n    rows, cols = len(grid), len(grid[0])\\n    visited = [[False for _ in range(cols)] for _ in range(rows)]\\n    \\n    def is_safe(x, y):\\n        return 0 <= x < rows and 0 <= y < cols and not visited[x][y] and grid[x][y] == 1\\n    \\n    def dfs(x, y):\\n        stack = [(x, y)]\\n        while stack:\\n            cx, cy = stack.pop()\\n            if is_safe(cx, cy):\\n                visited[cx][cy] = True\\n                # Check all 4 directions\\n                directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\\n                for dx, dy in directions:\\n                    stack.append((cx + dx, cy + dy))\\n\\n    count = 0\\n    for i in range(rows):\\n        for j in range(cols):\\n            if grid[i][j] == 1 and not visited[i][j]:\\n                dfs(i, j)\\n                count += 1\\n    \\n    return count\\n\"}", "output": "Done.\n\nfile solution.py: exists\nsource: 29 lines", "mcp_data": null}, "observed_at": 1789570299.411146}
