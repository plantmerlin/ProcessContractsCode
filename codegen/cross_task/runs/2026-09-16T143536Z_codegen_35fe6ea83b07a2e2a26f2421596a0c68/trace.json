  "final_source": "def binary_search(arr, val, start, end):\n    # While there is a valid range\n    while start < end:\n        mid = (start + end) // 2\n        # If the mid value is less than the target value\n        if arr[mid] < val:\n            start = mid + 1\n        else:\n            end = mid\n    return start\n\n\ndef solve(xs):\n    # Initialize the sorted array with the first element of the input list\n    sorted_array = []\n    for x in xs:\n        # Find the insertion index for x using binary search\n        insert_index = binary_search(sorted_array, x, 0, len(sorted_array))\n        # Insert x at its correct position\n        sorted_array.insert(insert_index, x)\n    return sorted_array\n",
