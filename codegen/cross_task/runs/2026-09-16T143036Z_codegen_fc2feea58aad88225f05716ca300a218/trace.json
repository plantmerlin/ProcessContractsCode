  "final_source": "def binary_search(arr, val, start, end):\n    \"\"\"\n    Helper function to perform binary search within arr to find the index\n    where val should be inserted to keep arr sorted.\n    \"\"\"\n    while start < end:\n        mid = (start + end) // 2\n        if arr[mid] < val:\n            start = mid + 1\n        else:\n            end = mid\n    return start\n\n\ndef solve(xs):\n    \"\"\"\n    Sort list xs using binary insertion sort and return the sorted list.\n\n    Parameters:\n    xs (list of int): List of integers to sort.\n\n    Returns:\n    list of int: Sorted list of integers.\n    \"\"\"\n    sorted_list = []\n    for x in xs:\n        pos = binary_search(sorted_list, x, 0, len(sorted_list))\n        sorted_list.insert(pos, x)\n    return sorted_list\n",
