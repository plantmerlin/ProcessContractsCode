  "final_source": "def solve(grid):\n    if not grid:\n        return 0\n\n    def dfs(r, c):\n        if r < 0 or r >= len(grid) or c < 0 or c >= len(grid[0]) or grid[r][c] == 0:\n            return\n        # Mark the land as visited\n        grid[r][c] = 0\n        # Visit all connecting land horizontally and vertically\n        dfs(r + 1, c)\n        dfs(r - 1, c)\n        dfs(r, c + 1)\n        dfs(r, c - 1)\n\n    islands = 0\n    for row in range(len(grid)):\n        for col in range(len(grid[0])):\n            if grid[row][col] == 1:\n                # Start a DFS to mark all parts of this island\n                dfs(row, col)\n                islands += 1\n\n    return islands",
