  "final_source": "def binary_search(arr, val, start, end):\n    \"\"\"Helper function to perform binary search.\"\"\"\n    while start < end:\n        mid = (start + end) // 2\n        if arr[mid] < val:\n            start = mid + 1\n        else:\n            end = mid\n    return start\n\n\ndef solve(xs):\n    \"\"\"Sorts a list of integers using binary insertion sort.\"\"\"\n    for i in range(1, len(xs)):\n        val = xs[i]\n        # Find location where the current element should be inserted\n        j = binary_search(xs, val, 0, i)\n        # Insert the current element into the sorted part\n        xs = xs[:j] + [val] + xs[j:i] + xs[i+1:]\n    return xs\n",
  "final_stdout": "[1, 2, 3, 4, 5, 6, 7, 8, 9]\n",
