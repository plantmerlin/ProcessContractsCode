  "final_source": "def solve(xs):\n    n = len(xs)\n    arr = xs.copy()\n    for i in range(n):\n        for j in range(0, n-i-1):\n            if arr[j] > arr[j+1]:\n                arr[j], arr[j+1] = arr[j+1], arr[j]\n    return arr\n",
