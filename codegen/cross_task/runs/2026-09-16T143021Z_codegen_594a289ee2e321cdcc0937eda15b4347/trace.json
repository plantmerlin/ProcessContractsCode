  "final_source": "def solve(xs):\n    def binary_search(sub_list, item):\n        low, high = 0, len(sub_list) - 1\n        while low <= high:\n            mid = (low + high) // 2\n            if sub_list[mid] < item:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return low\n\n    sorted_list = []\n    for x in xs:\n        pos = binary_search(sorted_list, x)\n        sorted_list.insert(pos, x)\n    return sorted_list\n",
