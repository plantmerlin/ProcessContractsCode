  "final_source": "def solve(orders):\n    # Create a dictionary to store total spending per customer\n    customer_spending = {}\n    \n    # Iterate over each order\n    for order in orders:\n        # Check that the order is not cancelled\n        if order['status'] != 'cancelled':\n            customer = order['customer']\n            total = order['qty'] * order['unit_cents']\n            \n            # Add the total to the customer's spending\n            if customer in customer_spending:\n                customer_spending[customer] += total\n            else:\n                customer_spending[customer] = total\n    \n    return customer_spending\n",
  "final_stdout": "{\"ana\": 1749, \"ben\": 2749, \"cara\": 1500}\n",
