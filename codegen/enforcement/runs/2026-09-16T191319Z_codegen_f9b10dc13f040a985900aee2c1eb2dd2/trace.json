  "final_source": "def solve(phrases):\n    # List of small words that should remain lowercase unless they are the first or last word\n    small_words = {'a', 'an', 'and', 'of', 'the', 'in', 'on'}\n    \n    def title_case(phrase):\n        words = phrase.split()\n        \n        # Apply capitalization rules to each word\n        new_words = [words[0].capitalize()] if words else []\n        for word in words[1:-1]:\n            if word.lower() in small_words:\n                new_words.append(word.lower())\n            else:\n                new_words.append(word.capitalize())\n        if len(words) > 1:\n            new_words.append(words[-1].capitalize())\n        \n        return ' '.join(new_words)\n    \n    return [title_case(phrase) for phrase in phrases]",
  "final_stdout": "[\"The Lord of the Rings\", \"A Tale of Two Cities\", \"War and Peace\", \"Of Mice and Men\", \"What the Wind Blew In\"]\n",
