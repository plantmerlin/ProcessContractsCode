  "final_source": "def solve(phrases):\n    def title_case(phrase):\n        small_words = {'a', 'an', 'and', 'of', 'the', 'in', 'on'}\n        words = phrase.split()\n        titled = []\n        for i, word in enumerate(words):\n            if word.lower() in small_words and not (i == 0 or i == len(words) - 1):\n                titled.append(word.lower())\n            else:\n                titled.append(word.capitalize())\n        return ' '.join(titled)\n\n    return [title_case(phrase) for phrase in phrases]",
