  "final_source": "def solve(phrases):\n    def title_case(phrase):\n        small_words = {'a', 'an', 'and', 'of', 'the', 'in', 'on'}\n        words = phrase.split()\n        if not words:\n            return ''\n        \n        title_cased = []\n        for i, word in enumerate(words):\n            if word.lower() in small_words and i not in (0, len(words)-1):\n                title_cased.append(word.lower())\n            else:\n                title_cased.append(word.capitalize())\n        \n        return ' '.join(title_cased)\n    \n    return [title_case(phrase) for phrase in phrases]",
  "final_stdout": "[\"The Lord of the Rings\", \"A Tale of Two Cities\", \"War and Peace\", \"Of Mice and Men\", \"What the Wind Blew In\"]\n",
