  "final_source": "def solve(phrases):\n    small_words = {'a', 'an', 'and', 'of', 'the', 'in', 'on'}\n    \n    def title_case_word(word, is_first_or_last):\n        if word.lower() in small_words and not is_first_or_last:\n            return word.lower()\n        return word.capitalize()\n    \n    def title_case_phrase(phrase):\n        words = phrase.split()\n        result = []\n        for i, word in enumerate(words):\n            is_first_or_last = i == 0 or i == len(words) - 1\n            result.append(title_case_word(word, is_first_or_last))\n        return ' '.join(result)\n\n    return [title_case_phrase(phrase) for phrase in phrases]",
  "final_stdout": "[\"The Lord of the Rings\", \"A Tale of Two Cities\", \"War and Peace\", \"Of Mice and Men\", \"What the Wind Blew In\"]\n",
