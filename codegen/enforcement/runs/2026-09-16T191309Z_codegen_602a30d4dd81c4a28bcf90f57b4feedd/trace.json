  "final_source": "def title_case_word(word, is_first_or_last):\n    small_words = {'a', 'an', 'and', 'of', 'the', 'in', 'on'}\n    if word.lower() in small_words and not is_first_or_last:\n        return word.lower()\n    return word.capitalize()\n\ndef solve(phrases):\n    result = []\n    for phrase in phrases:\n        words = phrase.split()\n        title_cased = [\n            title_case_word(word, i == 0 or i == len(words) - 1)\n            for i, word in enumerate(words)\n        ]\n        result.append(' '.join(title_cased))\n    return result",
  "final_stdout": "[\"The Lord of the Rings\", \"A Tale of Two Cities\", \"War and Peace\", \"Of Mice and Men\", \"What the Wind Blew In\"]\n",
